{
  "name": "@deepseek-ai/dsh-chrome-protocol",
  "description": "Executable protocol vocabulary shared by the DSH Chrome host and connector",
  "version": "0.1.1-rc.2",
  "publishConfig": { "access": "public" },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": { "types": "./lib/types/index.d.ts", "default": "./lib/index.js" },
    "./invariant": { "types": "./lib/types/invariant.d.ts", "default": "./lib/invariant.js" },
    "./src/*": "./src/*",
    "./package.json": "./package.json"
  },
  "files": ["lib/index.js", "lib/invariant.js", "lib/types/**/*.d.ts"],
  "license": "MIT",
  "scripts": {
    "generate": "tsx scripts/generate-connector-runtime.ts",
    "check:fresh": "tsx scripts/generate-connector-runtime.ts --check",
    "test": "vitest run --root ../../.. packages/chrome/chrome-protocol/tests"
  },
  "peerDependencies": {
    "@deepseek-ai/dsh-brand": "workspace:^"
  },
  "devDependencies": {
    "effect": "4.0.0-beta.98",
    "tsx": "^4.22.4",
    "@deepseek-ai/dsh-brand": "workspace:^",
    "@deepseek-ai/dsh-invariants": "workspace:^",
    "@deepseek-ai/cordis": "workspace:^"
  }
}

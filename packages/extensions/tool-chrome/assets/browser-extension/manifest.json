{
  "manifest_version": 3,
  "name": "DSH Chrome Connector",
  "description": "Lets DSH control tabs in Chrome via a local connector.",
  "permissions": [
    "tabs",
    "tabGroups",
    "scripting",
    "storage",
    "unlimitedStorage",
    "alarms",
    "debugger"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "externally_connectable": {
    "matches": [
      "http://localhost/*",
      "http://127.0.0.1/*"
    ]
  },
  "action": {
    "default_title": "DSH Chrome Connector",
    "default_popup": "popup.html"
  },
  "key": "",
  "version": "0.5.3",
  "minimum_chrome_version": "120",
  "background": {
    "service_worker": "service-worker.js"
  }
}
